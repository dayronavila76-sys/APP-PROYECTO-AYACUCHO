@startuml
entity atractivos { * id : INTEGER <<PK>>
--
 nombre : TEXT
 interes : TEXT
 costo : REAL
 duracion : INTEGER }
entity itinerarios { * id : INTEGER <<PK>>
--
 dias : INTEGER
 presupuesto : REAL
 intereses : TEXT
 costo_estimado : REAL
 creado_en : TEXT }
entity itinerario_detalle { * itinerario_id : INTEGER <<FK>>
 * atractivo_id : INTEGER <<FK>>
--
 dia : INTEGER }
itinerarios ||--o{ itinerario_detalle
atractivos ||--o{ itinerario_detalle
@enduml
